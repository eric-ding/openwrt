+/* Validate every frame before any legacy offset access. */
+static int NjitNextFrame(pcap_t *handle, struct pcap_pkthdr **header, const uint8_t **packet)
+{
+    if(njit_stopping())return -2;
+    int result=pcap_next_ex(handle,header,packet);
+    if(result<0){njit_event("interface_error");return -2;}
+    if(result==1 && (!*header || !njit_frame_valid(*packet,(*header)->caplen)))return 0;
+    return result;
+}
+static int NjitFilter(pcap_t *handle,struct bpf_program *code,const char *filter)
+{
+    if(pcap_compile(handle,code,filter,1,0xff)<0)return -1;
+    int result=pcap_setfilter(handle,code);
+    pcap_freecode(code);
+    return result;
+}
+static int NjitRejected(const uint8_t *packet)
+{
+    unsigned length=((unsigned)packet[20]<<8)|packet[21];
+    if(length<6 || packet[22]!=9)return 0;
+    unsigned size=packet[23];
+    for(unsigned i=0;i+5<=size;i++)
+        if(!memcmp(packet+24+i,"E2531",5) || !memcmp(packet+24+i,"E2553",5))return 1;
+    return 0;
+}
 
