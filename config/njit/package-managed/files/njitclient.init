#!/bin/sh /etc/rc.common
# Saving settings never calls start. No global DHCP/process termination.
START=95
STOP=10
USE_PROCD=1

boot() {
	local autostart
	config_load njitclient
	. /usr/share/libubox/jshn.sh
	json_load "$(/usr/libexec/rpcd/njitclient options)" || return 1
	json_get_var autostart autostart
	[ "$autostart" = 1 ] || return 0
	NJIT_BOOT=1 start "$@"
}

start_service() {
	local enabled device
	config_load njitclient
	config_get_bool enabled main enabled 0
	config_get device main device wan
	[ "$enabled" = 1 ] || [ "${NJIT_BOOT:-0}" = 1 ] || return 0
	[ "$device" = wan ] || return 1
	/usr/sbin/njit-client --check-config /etc/njitclient/credentials >/dev/null 2>&1 || return 1
	procd_open_instance main
	procd_set_param command /usr/sbin/njit-client --config /etc/njitclient/credentials --interface wan
	# Client manages optional reconnect; procd must not bypass a disabled switch.
	procd_set_param term_timeout 8
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}
